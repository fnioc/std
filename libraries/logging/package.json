{
  "name": "@rhombus-std/logging",
  "version": "0.0.0",
  "description": "Logging runtime: LoggerFactory/Logger/NullLogger, LoggerFilterOptions/Rule, and getLoggingManifest -- the logging registrations, published as a manifest to merge into your own. Providers are out of scope.",
  "keywords": [
    "logging",
    "ioc",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fnioc/std.git",
    "directory": "libraries/logging"
  },
  "type": "module",
  "main": "./src/index.ts",
  "sideEffects": true,
  "exports": {
    ".": "./src/index.ts",
    "./private/*": "./src/*.ts"
  },
  "files": [
    "dist",
    "!dist/stage"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-lib.ts",
    "lint": "bun x tsc --noEmit -p tsconfig.ci.json"
  },
  "dependencies": {
    "@rhombus-std/di": "workspace:*",
    "@rhombus-std/di.core": "workspace:*",
    "@rhombus-std/logging.core": "workspace:*",
    "@rhombus-std/options": "workspace:*",
    "@rhombus-std/options.augmentations": "workspace:*",
    "@rhombus-std/primitives": "workspace:*",
    "@rhombus-toolkit/types": "^2.0.0"
  },
  "devDependencies": {
    "@rhombus-std/di.extras": "workspace:*",
    "@rhombus-std/primitives.extras": "workspace:*",
    "@ttsc/unplugin": "^0.18.1",
    "ttsc": "^0.18.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/bundle/index.js",
    "exports": {
      ".": "./dist/bundle/index.js"
    }
  }
}
