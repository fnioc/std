{
  "name": "@rhombus-std/fileproviders.core",
  "version": "0.0.0",
  "description": "Read-only file provider abstractions: IFileProvider/IFileInfo/IDirectoryContents plus the null-object helpers (NotFoundFileInfo, NotFoundDirectoryContents, NullFileProvider, NullChangeToken). Depends on @rhombus-std/primitives for the IChangeToken type.",
  "keywords": [
    "fileproviders",
    "filesystem",
    "abstractions",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fnioc/std.git",
    "directory": "libraries/fileproviders.core"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./private/*": "./src/*.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-lib.ts",
    "lint": "bun x tsc --noEmit -p tsconfig.ci.json"
  },
  "dependencies": {
    "@rhombus-std/primitives": "workspace:*",
    "@rhombus-toolkit/types": "^2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/bundle/index.js",
    "exports": {
      ".": "./dist/bundle/index.js"
    }
  }
}
