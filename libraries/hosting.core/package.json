{
  "name": "@rhombus-std/hosting.core",
  "version": "0.0.0",
  "description": "Hosting abstractions: IHost/IHostedService/IHostedLifecycleService/BackgroundService, IHostApplicationLifetime/IHostLifetime, the IHostBuilder/IHostApplicationBuilder builder contracts, HostBuilderContext/IHostEnvironment, and getHostedServiceManifest -- the hosted-service registration, published as a manifest to merge into your own.",
  "keywords": [
    "hosting",
    "generic-host",
    "abstractions",
    "hosted-service",
    "lifetime",
    "ioc",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fnioc/std.git",
    "directory": "libraries/hosting.core"
  },
  "type": "module",
  "main": "./src/index.ts",
  "sideEffects": true,
  "exports": {
    ".": "./src/index.ts",
    "./private/*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/bundle/index.js",
    "exports": {
      ".": "./dist/bundle/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/stage"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-lib.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@rhombus-std/config.core": "workspace:*",
    "@rhombus-std/di.core": "workspace:*",
    "@rhombus-std/diagnostics.core": "workspace:*",
    "@rhombus-std/fileproviders.core": "workspace:*",
    "@rhombus-std/logging.core": "workspace:*",
    "@rhombus-std/primitives": "workspace:*",
    "@rhombus-toolkit/types": "^2.0.0"
  },
  "devDependencies": {
    "@rhombus-std/di.extras": "workspace:*",
    "@rhombus-std/primitives.extras": "workspace:*",
    "@ttsc/unplugin": "^0.18.1",
    "rollup": "^4.61.0",
    "rollup-plugin-dts": "^6.4.1",
    "ttsc": "^0.18.1",
    "typescript": "^6.0.3"
  }
}
