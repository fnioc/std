{
  "name": "@rhombus-std/caching.memory",
  "version": "0.0.0",
  "description": "In-memory cache implementation: MemoryCache + MemoryCacheOptions/MemoryCacheEntryOptions, the memory-backed MemoryDistributedCache + MemoryDistributedCacheOptions, plus getMemoryCacheManifest/getDistributedMemoryCacheManifest -- the IMemoryCache/IDistributedCache registrations, published as a manifest to merge into your own.",
  "keywords": [
    "caching",
    "cache",
    "memory-cache",
    "ioc",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fnioc/std.git",
    "directory": "libraries/caching.memory"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": true,
  "exports": {
    ".": "./src/index.ts",
    "./private/*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts"
    }
  },
  "files": [
    "dist",
    "!dist/stage"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-lib.ts",
    "lint": "bun x tsc --noEmit -p tsconfig.ci.json"
  },
  "dependencies": {
    "@rhombus-std/caching.core": "workspace:*",
    "@rhombus-std/di.core": "workspace:*",
    "@rhombus-std/logging.core": "workspace:*",
    "@rhombus-std/options": "workspace:*",
    "@rhombus-std/options.augmentations": "workspace:*",
    "@rhombus-std/primitives": "workspace:*",
    "@rhombus-toolkit/func": "^3.6.0",
    "@rhombus-toolkit/type-guards": "^2.0.1"
  },
  "devDependencies": {
    "@rhombus-std/di.extras": "workspace:*",
    "@rhombus-std/primitives.extras": "workspace:*",
    "@ttsc/unplugin": "^0.18.1",
    "ttsc": "^0.18.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/bundle/index.js",
    "types": "./dist/bundle/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/bundle/index.d.ts",
        "import": "./dist/bundle/index.js",
        "default": "./dist/bundle/index.js"
      }
    }
  }
}
