{
  "name": "@rhombus-std/di.extras",
  "version": "10.1.0",
  "description": "The ioc authoring surface: the build-time primitives a registration author writes against. A Go/ttsc descriptor package — the primitive-transform runs in the shared owner binary.",
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "typescript",
    "transformer",
    "compiler"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fnioc/std.git",
    "directory": "libraries/di.extras"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ttsc": "./ttsc.mjs",
    "./private/*": "./src/*.ts"
  },
  "ttsc": {
    "plugin": {
      "transform": "./ttsc.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "ttsc.mjs"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-lib.ts",
    "lint": "tsc --noEmit -p tsconfig.ci.json"
  },
  "dependencies": {
    "@rhombus-std/di.core": "workspace:*",
    "@rhombus-std/primitives": "workspace:*",
    "@rhombus-std/primitives.extras": "workspace:*",
    "@rhombus-std/transforms": "workspace:^",
    "@rhombus-toolkit/func": "3.6.0",
    "@rhombus-toolkit/types": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/bundle/index.js",
    "exports": {
      ".": {
        "source": "./src/index.ts",
        "default": "./dist/bundle/index.js"
      },
      "./ttsc": "./ttsc.mjs"
    }
  }
}
