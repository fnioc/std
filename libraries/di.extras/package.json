{
  "name": "@rhombus-std/di.extras",
  "version": "10.1.0",
  "description": "The ioc authoring surface: the build-time primitives a registration author writes against. A Go/ttsc descriptor package \u2014 the primitive-transform runs in the shared owner binary.",
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "typescript",
    "transformer",
    "compiler"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fnioc/std.git",
    "directory": "libraries/di.extras"
  },
  "type": "module",
  "//rhombus-std": "The type-driven sugar publish list. Every member takes its service type as a type argument and no token argument, and forwards to the same-named member with `tokenfor<T>()` in front \u2014 the inline stage substitutes that body at the consumer call site. The `type` ANCHOR names the interface the member is declared on, which is the augmentation target rather than this package; `impl` is a fully-qualified reference to the augmentation set here that carries the body.",
  "rhombus-std": {
    "inline": [
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestServiceAugmentations",
        "member": "add"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestServiceAugmentations",
        "member": "addClass"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestServiceAugmentations",
        "member": "addFactory"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestServiceAugmentations",
        "member": "addValue"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestDescriptorAugmentations",
        "member": "tryAdd"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestDescriptorAugmentations",
        "member": "tryAddClass"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestDescriptorAugmentations",
        "member": "tryAddFactory"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestDescriptorAugmentations",
        "member": "tryAddValue"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestDescriptorAugmentations",
        "member": "replaceClass"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestDescriptorAugmentations",
        "member": "replaceFactory"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestDescriptorAugmentations",
        "member": "replaceValue"
      },
      {
        "type": "@rhombus-std/di.core:Manifest",
        "impl": "@rhombus-std/di.extras:ManifestDescriptorAugmentations",
        "member": "removeAll"
      },
      {
        "type": "@rhombus-std/primitives:IServiceProvider",
        "impl": "@rhombus-std/di.extras:ServiceProviderServiceAugmentations",
        "member": "getService"
      },
      {
        "type": "@rhombus-std/primitives:IServiceProvider",
        "impl": "@rhombus-std/di.extras:ServiceProviderServiceAugmentations",
        "member": "getRequiredService"
      },
      {
        "type": "@rhombus-std/primitives:IServiceProvider",
        "impl": "@rhombus-std/di.extras:ServiceProviderServiceAugmentations",
        "member": "getServices"
      }
    ]
  },
  "types": "./dist/bundle/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/bundle/index.d.ts"
    },
    "./ttsc": "./ttsc.mjs",
    "./tokens/*": {
      "source": "./src/*.ts",
      "bun": "./src/*.ts",
      "types": "./src/*.ts"
    }
  },
  "ttsc": {
    "plugin": {
      "transform": "@rhombus-std/di.extras/ttsc"
    }
  },
  "//rhombusBuild": "typesOnly -- an authoring-only package: its members are substituted at a consumer's call site by the inline stage (walked from src by the ttsc engine, never value-imported), so it ships no runtime bundle -- only the rolled .d.ts the declare-module sugar needs to typecheck.",
  "rhombusBuild": {
    "typesOnly": true
  },
  "files": [
    "dist",
    "ttsc.mjs"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-lib.ts",
    "lint": "tsc --noEmit -p tsconfig.ci.json"
  },
  "dependencies": {
    "@rhombus-std/primitives": "workspace:*",
    "@rhombus-std/primitives.extras": "workspace:*",
    "@rhombus-toolkit/func": "3.5.3"
  },
  "peerDependencies": {
    "@rhombus-std/di.core": "workspace:^",
    "typescript": ">=5.2"
  },
  "devDependencies": {
    "@rhombus-std/di.core": "workspace:*",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "types": "./dist/bundle/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/bundle/index.d.ts"
      },
      "./ttsc": "./ttsc.mjs"
    }
  }
}
