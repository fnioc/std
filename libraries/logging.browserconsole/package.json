{
  "name": "@rhombus-std/logging.browserconsole",
  "version": "0.0.0",
  "description": "Browser console logging provider: BrowserConsoleLogger + BrowserConsoleLoggerProvider writing through the console global (console.error/warn/info/debug mapped from LogLevel, plain formatting, no ANSI) — against @rhombus-std/logging.core's ILogger/ILoggerProvider contracts.",
  "keywords": [
    "logging",
    "browser",
    "console",
    "logger",
    "ioc",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fnioc/std.git",
    "directory": "libraries/logging.browserconsole"
  },
  "type": "module",
  "sideEffects": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./private/*": "./src/*.ts"
  },
  "files": [
    "dist",
    "!dist/stage"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-lib.ts",
    "lint": "bun x tsc --noEmit -p tsconfig.ci.json"
  },
  "dependencies": {
    "@rhombus-std/logging": "workspace:*",
    "@rhombus-std/logging.core": "workspace:*",
    "@rhombus-std/primitives": "workspace:*",
    "@rhombus-toolkit/type-helpers": "^2.0.0"
  },
  "devDependencies": {
    "@rhombus-std/primitives.extras": "workspace:*",
    "@rhombus-toolkit/func": "3.6.0",
    "@ttsc/unplugin": "^0.18.1",
    "ttsc": "^0.18.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/bundle/index.js",
    "exports": {
      ".": "./dist/bundle/index.js"
    }
  }
}
