{
  "name": "@rhombus-std/config.extras",
  "version": "0.0.0",
  "description": "The @rhombus-std/config authoring surface: types .withType<T>() onto ConfigBuilder and rewrites it into a generated .withSchema(Type.object({...})) call at compile time. A Go/ttsc descriptor package — the transform runs in the shared owner binary.",
  "keywords": [
    "configuration",
    "config",
    "ioc",
    "typescript",
    "transformer",
    "compiler"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fnioc/std.git",
    "directory": "libraries/config.extras"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ttsc": "./ttsc.mjs",
    "./private/*": "./src/*.ts"
  },
  "ttsc": {
    "plugin": {
      "transform": "./ttsc.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "ttsc.mjs"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-lib.ts",
    "lint": "bun x tsc --noEmit -p tsconfig.ci.json"
  },
  "dependencies": {
    "@rhombus-std/config": "workspace:*",
    "@rhombus-std/config.core": "workspace:*",
    "@rhombus-std/primitives": "workspace:*",
    "@rhombus-std/primitives.extras": "workspace:*",
    "@rhombus-std/transforms": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/bundle/index.js",
    "exports": {
      ".": {
        "source": "./src/index.ts",
        "default": "./dist/bundle/index.js"
      },
      "./ttsc": "./ttsc.mjs"
    }
  },
  "main": "./src/index.ts",
  "devDependencies": {}
}
