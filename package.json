{
  "name": "@rhombus-std/monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "libraries/*",
    "examples/*",
    "tests/*"
  ],
  "scripts": {
    "build": "bun scripts/build-all.ts",
    "test": "bun --filter '*' test && bun scripts/run-e2e.mjs",
    "test:e2e": "bun scripts/run-e2e.mjs",
    "lint": "bun scripts/derive-publish-config.ts --check && bun --filter '*' lint",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "knip": "knip --tsConfig tsconfig.knip.json --no-exit-code",
    "typecheck": "tsc -b",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@types/bun": "^1.3.0",
    "@typescript/typescript6": "^6.0.2",
    "dprint": "^0.54.0",
    "eslint": "^10.4.1",
    "rolldown": "^1.2.0",
    "rolldown-plugin-dts": "^0.27.14",
    "rollup": "^4.61.0",
    "rollup-plugin-dts": "^6.4.1",
    "semantic-release": "^25.0.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.60.1"
  }
}
