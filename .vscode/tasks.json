{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "bun run build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "bun run test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "build app.with-transformer",
      "type": "shell",
      "command": "bun run build",
      "options": { "cwd": "${workspaceFolder}/examples/examples.app.with-transformer" },
      "problemMatcher": []
    },
    {
      "label": "build app.without-transformer",
      "type": "shell",
      "command": "bun run build",
      "options": { "cwd": "${workspaceFolder}/examples/examples.app.without-transformer" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "bootstrap",
      "type": "shell",
      "command": "git pull && bun install",
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": []
    }
  ]
}
